# Supabase — keep the secret key server-side only
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Existing projects may use this legacy key name instead of SUPABASE_SECRET_KEY
SUPABASE_SERVICE_ROLE_KEY=

# Gemini — server-side only
GEMINI_API_KEY=

# Admin — use a strong password and a random session secret of at least 32 characters
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
